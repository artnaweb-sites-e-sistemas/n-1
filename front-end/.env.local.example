# Copie para .env.local (na pasta front-end).
# Depois de salvar: pare e rode de novo `npm run dev`.

# Obrigatório — URL base da API WordPress (plugin N-1)
NEXT_PUBLIC_API_BASE_URL=https://n-1.artnaweb.com.br/wp-json/n1/v1

# Public Key do Mercado Pago (igual à do wp-config N1_MERCADO_PAGO_PUBLIC_KEY)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-5d2877df-7996-4033-b9e3-1847ff9e113f

# Brevo (newsletter "Receba nossas novidades") — só no servidor; não usar NEXT_PUBLIC_
# Chave: Brevo → Configurações → SMTP e API → Chaves API (v3)
# Lista: CRM → Contatos → Listas → abra a lista; o ID aparece na URL (.../list/id/123) ou nos detalhes
BREVO_API_KEY=
BREVO_LIST_ID=

# Reconciliação Olist ↔ Woo por SKU no proxy /wp-json (POST /wc/v2|v3/products).
# true = se o SKU já existir, devolve o produto (201) em vez de criar (evita product_invalid_sku).
# Desligar após o vínculo em massa.
SKU_RECONCILE_ENABLED=false
